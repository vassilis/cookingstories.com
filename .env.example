# Copy to .env.local for development. In Coolify, set these as environment variables.

# Postgres (Coolify's Postgres resource gives you this URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cookingstories

# Better Auth: generate the secret with `openssl rand -hex 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Emails that get admin rights on first sign-in (comma separated)
ADMIN_EMAILS=

# Brevo transactional email (Settings > SMTP & API > API keys).
# Add cookingstories.com as its own sender domain with SPF, DKIM and DMARC.
BREVO_API_KEY=
EMAIL_FROM=hello@cookingstories.com
EMAIL_FROM_NAME=Cooking Stories

# Optional: Sign in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 for recipe photos (not used by any page yet)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cookingstories-photos
R2_PUBLIC_URL=https://images.cookingstories.com

# Tests: separate, throwaway databases (they get emptied)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cookingstories_test
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cookingstories_e2e
